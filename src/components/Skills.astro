---
import { skillGroups } from '../data/resume';
---

<section class="section section-alt" id="skills">
  <div class="container">
    <p class="eyebrow">Habilidades</p>
    <h2 class="section-heading">O que eu utilizo</h2>
    {
      skillGroups.map((group) => (
        <div class="skill-group">
          <h3>{group.title}</h3>
          <div class="chip-row">
            {group.skills.map((s) => <span class="chip">{s}</span>)}
          </div>
        </div>
      ))
    }
  </div>
</section>
